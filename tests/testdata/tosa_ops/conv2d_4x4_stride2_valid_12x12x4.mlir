// 4x4 stride-2 conv with no padding (synaptics-torq/torq-compiler-dev#2717)
module {
  func.func @main(%arg0: tensor<1x12x12x4xi8>) -> tensor<1x5x5x8xi8> {
    %w = "tosa.const"() <{values = dense<""> : tensor<8x4x4x4xi8>}> : () -> tensor<8x4x4x4xi8>
    %b = "tosa.const"() <{values = dense<"0xE203000049FEFFFFD5FEFFFF5F0200006EFDFFFF9BFEFFFF27FFFFFFC4010000"> : tensor<8xi32>}> : () -> tensor<8xi32>
    %izp = "tosa.const"() <{values = dense<-128> : tensor<1xi8>}> : () -> tensor<1xi8>
    %wzp = "tosa.const"() <{values = dense<0> : tensor<1xi8>}> : () -> tensor<1xi8>
    %m = "tosa.const"() <{values = dense<"0x94F83170BFC87572A9531C5C495F62670B05A865BC476A7125A4264801785C54"> : tensor<8xi32>}> : () -> tensor<8xi32>
    %sh = "tosa.const"() <{values = dense<"0x2626262626262626"> : tensor<8xi8>}> : () -> tensor<8xi8>
    %rzp = "tosa.const"() <{values = dense<0> : tensor<1xi32>}> : () -> tensor<1xi32>
    %ozp = "tosa.const"() <{values = dense<-128> : tensor<1xi8>}> : () -> tensor<1xi8>
    %0 = tosa.conv2d %arg0, %w, %b, %izp, %wzp {acc_type = i32, dilation = array<i64: 1, 1>, pad = array<i64: 0, 0, 0, 0>, stride = array<i64: 2, 2>} : (tensor<1x12x12x4xi8>, tensor<8x4x4x4xi8>, tensor<8xi32>, tensor<1xi8>, tensor<1xi8>) -> tensor<1x5x5x8xi32>
    %1 = tosa.rescale %0, %m, %sh, %rzp, %ozp {input_unsigned = false, output_unsigned = false, per_channel = true, rounding_mode = DOUBLE_ROUND, scale32 = true} : (tensor<1x5x5x8xi32>, tensor<8xi32>, tensor<8xi8>, tensor<1xi32>, tensor<1xi8>) -> tensor<1x5x5x8xi8>
    return %1 : tensor<1x5x5x8xi8>
  }
}

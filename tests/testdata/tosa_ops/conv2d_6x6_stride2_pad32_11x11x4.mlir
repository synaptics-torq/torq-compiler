// 6x6 stride-2 conv with padding 3 then 2 (synaptics-torq/torq-compiler-dev#2717)
module {
  func.func @main(%arg0: tensor<1x11x11x4xi8>) -> tensor<1x6x6x8xi8> {
    %w = "tosa.const"() <{values = dense<""> : tensor<8x6x6x4xi8>}> : () -> tensor<8x6x6x4xi8>
    %b = "tosa.const"() <{values = dense<"0xD9010000A4FDFFFF92FDFFFF100100008FFCFFFF410200007DFDFFFFD5000000"> : tensor<8xi32>}> : () -> tensor<8xi32>
    %izp = "tosa.const"() <{values = dense<-128> : tensor<1xi8>}> : () -> tensor<1xi8>
    %wzp = "tosa.const"() <{values = dense<0> : tensor<1xi8>}> : () -> tensor<1xi8>
    %m = "tosa.const"() <{values = dense<"0xE4125A6854FF424C1419AB598770874767B5C77E0ADB61601EB77A498E523174"> : tensor<8xi32>}> : () -> tensor<8xi32>
    %sh = "tosa.const"() <{values = dense<"0x2626262626262626"> : tensor<8xi8>}> : () -> tensor<8xi8>
    %rzp = "tosa.const"() <{values = dense<0> : tensor<1xi32>}> : () -> tensor<1xi32>
    %ozp = "tosa.const"() <{values = dense<-128> : tensor<1xi8>}> : () -> tensor<1xi8>
    %0 = tosa.conv2d %arg0, %w, %b, %izp, %wzp pad([3, 2, 3, 2]) stride([2, 2]) dilation([1, 1]) acc_type(i32) : (tensor<1x11x11x4xi8>, tensor<8x6x6x4xi8>, tensor<8xi32>, tensor<1xi8>, tensor<1xi8>) -> tensor<1x6x6x8xi32>
    %1 = tosa.rescale %0, %m, %sh, %rzp, %ozp scale32(true) rounding_mode<DOUBLE_ROUND> per_channel(true) input_unsigned(false) output_unsigned(false) : (tensor<1x6x6x8xi32>, tensor<8xi32>, tensor<8xi8>, tensor<1xi32>, tensor<1xi8>) -> tensor<1x6x6x8xi8>
    return %1 : tensor<1x6x6x8xi8>
  }
}

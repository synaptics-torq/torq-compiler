// Regression: filter height equals output channels, so the wrong activation-style
// transpose of a filter reduction remains shape-valid but sums the wrong axis.
// Both zero points are nonzero; synthetic weights include both i8 endpoints.
// Validate NSS-only output against the CPU reference, not just compilation.
module {
  func.func @main(%arg0: tensor<1x8x8x32xi8>) -> tensor<1x6x6x3xi8> {
    %weights = "tosa.const"() <{values = dense<""> : tensor<3x3x3x32xi8>}> : () -> tensor<3x3x3x32xi8>
    %bias = "tosa.const"() <{values = dense<[224, 371, -48]> : tensor<3xi32>}> : () -> tensor<3xi32>
    %input_zp = "tosa.const"() <{values = dense<-128> : tensor<1xi8>}> : () -> tensor<1xi8>
    %weight_zp = "tosa.const"() <{values = dense<-5> : tensor<1xi8>}> : () -> tensor<1xi8>
    %acc_zp = "tosa.const"() <{values = dense<0> : tensor<1xi32>}> : () -> tensor<1xi32>
    %output_zp = "tosa.const"() <{values = dense<-128> : tensor<1xi8>}> : () -> tensor<1xi8>
    %multiplier = "tosa.const"() <{values = dense<1241689856> : tensor<1xi32>}> : () -> tensor<1xi32>
    %shift = "tosa.const"() <{values = dense<43> : tensor<1xi8>}> : () -> tensor<1xi8>
    %conv = tosa.conv2d %arg0, %weights, %bias, %input_zp, %weight_zp pad([0, 0, 0, 0]) stride([1, 1]) dilation([1, 1]) acc_type(i32) : (tensor<1x8x8x32xi8>, tensor<3x3x3x32xi8>, tensor<3xi32>, tensor<1xi8>, tensor<1xi8>) -> tensor<1x6x6x3xi32>
    %rescale = tosa.rescale %conv, %multiplier, %shift, %acc_zp, %output_zp scale32(true) rounding_mode<DOUBLE_ROUND> per_channel(false) input_unsigned(false) output_unsigned(false) : (tensor<1x6x6x3xi32>, tensor<1xi32>, tensor<1xi8>, tensor<1xi32>, tensor<1xi8>) -> tensor<1x6x6x3xi8>
    %out = tosa.clamp %rescale min_val(-128 : i8) max_val(127 : i8) : (tensor<1x6x6x3xi8>) -> tensor<1x6x6x3xi8>
    return %out : tensor<1x6x6x3xi8>
  }
}

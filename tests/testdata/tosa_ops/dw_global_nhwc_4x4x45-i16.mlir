// Global depthwise conv with an NHWC input: the kernel covers the whole 4x4 frame, so each
// channel gives one output pixel (as in the proxy_modelA_cut model). 45 channels, not a multiple
// of the channel vector size, exercise the channel split of the EK kernel.
// The biases are positive: the llvm-cpu reference gets negative i48 biases wrong (it saturates
// those channels to 32767).
module {
  func.func @main(%arg0: tensor<1x4x4x45xi16>) -> tensor<1x1x1x45xi16> {
    %w = "tosa.const"() <{values = dense<[[[[89], [35], [3], [-59], [-49], [-117], [-108], [-123], [-83], [80], [38], [105], [1], [27], [120], [59], [34], [11], [15], [111], [-57], [81], [44], [-127], [-27], [91], [14], [-119], [68], [59], [88], [-83], [-105], [93], [-122], [11], [-107], [-51], [-5], [-20], [-25], [-120], [-126], [-96], [-125]], [[44], [7], [38], [-62], [29], [67], [-30], [-10], [127], [78], [123], [-31], [47], [115], [38], [87], [48], [52], [-28], [96], [-93], [20], [56], [88], [6], [-32], [-48], [-20], [-4], [56], [99], [-109], [111], [8], [-36], [44], [18], [-63], [-45], [56], [24], [1], [-41], [66], [-28]], [[-44], [100], [-60], [-70], [55], [31], [-115], [-106], [-31], [85], [-25], [73], [-47], [-66], [74], [96], [-107], [-113], [44], [-42], [19], [-89], [92], [-13], [101], [76], [52], [-69], [68], [-114], [18], [-24], [127], [-77], [114], [-104], [31], [20], [102], [-51], [103], [44], [100], [-77], [66]], [[113], [-115], [-34], [35], [-101], [3], [33], [67], [109], [-23], [-15], [-7], [116], [-78], [0], [-115], [-19], [114], [31], [-38], [126], [26], [114], [-123], [-10], [85], [66], [-24], [-1], [-20], [7], [-69], [73], [-108], [-22], [-56], [60], [64], [54], [108], [110], [-80], [-98], [-94], [58]]], [[[120], [109], [43], [119], [95], [-124], [-97], [93], [-106], [123], [83], [117], [-36], [-90], [4], [121], [-34], [99], [-30], [82], [-69], [-5], [-44], [-68], [100], [77], [-92], [108], [120], [-60], [-19], [10], [40], [-15], [-90], [110], [49], [-117], [80], [59], [-81], [29], [0], [-120], [109]], [[56], [-48], [-123], [-104], [66], [-89], [3], [102], [109], [-59], [-111], [-1], [87], [32], [-110], [38], [-40], [-70], [-18], [95], [119], [-92], [16], [67], [-61], [-58], [-66], [-74], [99], [-72], [-70], [-96], [-96], [71], [-54], [77], [22], [91], [14], [67], [79], [-112], [15], [-12], [-54]], [[-12], [-22], [-2], [81], [83], [32], [54], [117], [35], [-33], [-107], [13], [-68], [24], [-121], [89], [113], [-90], [81], [-24], [-117], [105], [112], [-117], [24], [82], [74], [-22], [92], [84], [-99], [-125], [-101], [-34], [-100], [-107], [-62], [39], [6], [-58], [115], [52], [34], [113], [73]], [[-95], [-118], [93], [-24], [-112], [-6], [-30], [-18], [-18], [-47], [-3], [-2], [121], [49], [70], [-125], [-49], [123], [-59], [3], [93], [35], [97], [-86], [3], [35], [-40], [19], [126], [60], [-47], [-111], [-81], [-58], [97], [-58], [80], [-58], [43], [7], [117], [17], [109], [118], [63]]], [[[33], [92], [127], [-64], [16], [-91], [-101], [43], [-115], [55], [82], [-85], [46], [-27], [100], [105], [20], [16], [54], [20], [63], [-78], [72], [7], [64], [6], [-49], [-105], [6], [123], [-118], [18], [-13], [-126], [11], [70], [62], [122], [7], [23], [119], [-46], [76], [-80], [-35]], [[44], [20], [-78], [41], [20], [107], [26], [98], [118], [-105], [-109], [1], [0], [14], [62], [-47], [-82], [46], [-29], [110], [-111], [53], [58], [-58], [-105], [-46], [-27], [122], [95], [-69], [-7], [25], [105], [-93], [68], [108], [106], [-57], [-95], [24], [-109], [-94], [-110], [-74], [94]], [[44], [34], [124], [-1], [-117], [-86], [-61], [44], [-36], [-46], [-99], [54], [-121], [-10], [62], [2], [48], [74], [-70], [-104], [-113], [20], [-60], [-77], [60], [79], [116], [-3], [6], [125], [1], [-81], [-62], [118], [-116], [77], [38], [-5], [85], [80], [-15], [26], [67], [40], [-4]], [[105], [98], [-111], [12], [85], [-106], [-30], [2], [-44], [50], [126], [-35], [72], [-98], [-4], [-126], [-20], [-124], [96], [120], [-105], [81], [53], [-51], [74], [118], [76], [49], [-45], [27], [76], [55], [-70], [-22], [-35], [50], [-21], [-21], [11], [20], [-99], [108], [-24], [-83], [-127]]], [[[-17], [62], [-52], [90], [-77], [-92], [-28], [52], [-51], [82], [-122], [123], [-115], [88], [-127], [-19], [-49], [122], [39], [121], [-22], [1], [1], [65], [2], [106], [-79], [-6], [-65], [93], [-92], [51], [105], [-53], [-56], [68], [23], [18], [98], [-104], [-58], [-28], [106], [-109], [-12]], [[-6], [-124], [-18], [38], [-19], [-50], [22], [123], [-96], [-55], [111], [-52], [47], [-38], [83], [22], [101], [35], [21], [-3], [-117], [-97], [54], [36], [18], [-98], [83], [76], [8], [-63], [80], [6], [127], [-56], [-38], [77], [-84], [-45], [-28], [58], [65], [74], [-15], [29], [23]], [[69], [-95], [-46], [58], [-76], [-56], [122], [-79], [127], [93], [-88], [16], [-45], [-4], [28], [102], [110], [-106], [-82], [50], [-75], [-44], [22], [-83], [126], [45], [-70], [-35], [38], [-43], [31], [113], [-34], [-77], [-55], [3], [14], [-121], [37], [-86], [33], [98], [-78], [74], [-119]], [[14], [43], [-71], [72], [15], [-21], [-124], [-93], [54], [-24], [55], [118], [37], [62], [28], [-51], [-109], [29], [-65], [-97], [19], [28], [-27], [33], [125], [66], [108], [-110], [-89], [-36], [23], [50], [50], [104], [-93], [-84], [-48], [-85], [55], [-22], [102], [-55], [-40], [-51], [-67]]]]> : tensor<4x4x45x1xi8>}> : () -> tensor<4x4x45x1xi8>
    %b = "tosa.const"() <{values = dense<[681, 643, 409, 169, 757, 47, 804, 488, 549, 855, 262, 965, 644, 159, 119, 618, 25, 951, 966, 786, 506, 96, 69, 211, 673, 536, 169, 497, 172, 287, 764, 451, 393, 835, 410, 295, 289, 39, 666, 147, 773, 919, 350, 612, 236]> : tensor<45xi48>}> : () -> tensor<45xi48>
    %m = "tosa.const"() <{values = dense<[31, 18, 18, 22, 29, 16, 29, 28, 22, 16, 23, 27, 29, 18, 26, 24, 29, 27, 28, 29, 27, 22, 30, 24, 29, 17, 18, 24, 27, 31, 17, 29, 22, 31, 22, 30, 19, 21, 31, 31, 17, 18, 16, 30, 21]> : tensor<45xi16>}> : () -> tensor<45xi16>
    %s = "tosa.const"() <{values = dense<22> : tensor<45xi8>}> : () -> tensor<45xi8>
    %izp = "tosa.const"() <{values = dense<0> : tensor<1xi16>}> : () -> tensor<1xi16>
    %wzp = "tosa.const"() <{values = dense<0> : tensor<1xi8>}> : () -> tensor<1xi8>
    %azp = "tosa.const"() <{values = dense<0> : tensor<1xi48>}> : () -> tensor<1xi48>
    %dw = tosa.depthwise_conv2d %arg0, %w, %b, %izp, %wzp pad([0, 0, 0, 0]) stride([1, 1]) dilation([1, 1]) acc_type(i48) : (tensor<1x4x4x45xi16>, tensor<4x4x45x1xi8>, tensor<45xi48>, tensor<1xi16>, tensor<1xi8>) -> tensor<1x1x1x45xi48>
    %r = tosa.rescale %dw, %m, %s, %azp, %izp scale32(false) rounding_mode<SINGLE_ROUND> per_channel(true) input_unsigned(false) output_unsigned(false) : (tensor<1x1x1x45xi48>, tensor<45xi16>, tensor<45xi8>, tensor<1xi48>, tensor<1xi16>) -> tensor<1x1x1x45xi16>
    return %r : tensor<1x1x1x45xi16>
  }
}

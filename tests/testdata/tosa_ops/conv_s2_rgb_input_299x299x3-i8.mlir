module {
  func.func @main(%arg0: tensor<1x299x299x3xi8>) -> tensor<1x149x149x32xi8> {
    %275 = "tosa.const"() <{values = dense<[40, 38, 39, 55, 41, 41, 39, 54, 38, 40, 39, 57, 57, 55, 41, 40, 49, 40, 40, 55, 41, 41, 39, 40, 41, 40, 46, 38, 59, 42, 38, 42]> : tensor<32xi8>}> : () -> tensor<32xi8>
    %276 = "tosa.const"() <{values = dense<[1752495685, 1247928028, 1806590706, 1733598106, 1286660403, 1845394505, 1592194794, 1813085256, 1092875478, 1854011465, 1929474636, 1704061507, 1114525484, 1916140449, 1710116078, 1567788606, 1369916726, 1712004334, 1519164476, 1865994826, 1113478273, 1251194759, 1257360519, 1650679703, 1226284507, 1920433399, 1896753398, 1309103924, 1998942458, 2041493414, 1301731806, 1165553795]> : tensor<32xi32>}> : () -> tensor<32xi32>
    %277 = "tosa.const"() <{values = dense<0> : tensor<1xi32>}> : () -> tensor<1xi32>
    %278 = "tosa.const"() <{values = dense<""> : tensor<32x3x3x3xi8>}> : () -> tensor<32x3x3x3xi8>
    %279 = "tosa.const"() <{values = dense<[61864, 27202, -16089, -1073741824, 251829, 176436, -101581, -1073741824, 29093, 57940, -30923, -1073741824, -1073741824, -1073741824, 161629, 92143, 182558, 71015, -141033, -1073741824, 215811, 261792, 40106, -7928, 242049, 74676, 264321, 25056, 1073741760, 236781, -24217, 761411]> : tensor<32xi32>}> : () -> tensor<32xi32>
    %280 = "tosa.const"() <{values = dense<-128> : tensor<1xi8>}> : () -> tensor<1xi8>
    %281 = "tosa.const"() <{values = dense<0> : tensor<1xi8>}> : () -> tensor<1xi8>
    %282 = tosa.conv2d %arg0, %278, %279, %280, %281 {acc_type = i32, dilation = array<i64: 1, 1>, pad = array<i64: 0, 0, 0, 0>, stride = array<i64: 2, 2>} : (tensor<1x299x299x3xi8>, tensor<32x3x3x3xi8>, tensor<32xi32>, tensor<1xi8>, tensor<1xi8>) -> tensor<1x149x149x32xi32>
    %283 = tosa.rescale %282, %276, %275, %277, %280 {input_unsigned = false, output_unsigned = false, per_channel = true, rounding_mode = DOUBLE_ROUND, scale32 = true} : (tensor<1x149x149x32xi32>, tensor<32xi32>, tensor<32xi8>, tensor<1xi32>, tensor<1xi8>) -> tensor<1x149x149x32xi8>
    %284 = tosa.clamp %283 {max_val = 127 : i8, min_val = -128 : i8} : (tensor<1x149x149x32xi8>) -> tensor<1x149x149x32xi8>
    return %284 : tensor<1x149x149x32xi8>
  }

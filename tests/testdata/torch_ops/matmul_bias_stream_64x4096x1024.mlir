// MatMul [64,4096] x [4096,1024] + per-column f32 bias, compiled with
// --torq-convert-dtypes and --torq-prefetch-algorithm=stream-schedule (the
// SL2610 full-model flags). The stream schedule tiles N so that one fc-fast
// tile is 7 columns wide, and its bias read of 7 f32 (28 bytes) used to abort
// the descriptor generator: DEBR accepts only 4/8/16/32-byte reads. The
// weights are a small splat to keep the file small and the output dominated
// by the bias, so a wrong bias read fails the bf16 comparison; the bias must
// not be a splat.
// bf16 output: near-zero outputs (bias cancelling the matmul) are judged by
// the absolute gate, one bf16 ULP of the output range.
// TORQ_USE_ABS_TOL_GATE: 1
// TORQ_FP_ABS_TOL_FRAC: 0.01
module {
  func.func @main(%arg0: !torch.vtensor<[64,4096],f32>) -> !torch.vtensor<[64,1024],f32> attributes {torch.onnx_meta.ir_version = 14 : si64, torch.onnx_meta.opset_version = 21 : si64, torch.onnx_meta.producer_name = "", torch.onnx_meta.producer_version = ""} {
    %0 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<matmul_bias_stream_b> : tensor<1024xf32>} : () -> !torch.vtensor<[1024],f32> 
    %1 = torch.operator "onnx.Constant"() {torch.onnx.value = dense<1.000000e-04> : tensor<4096x1024xf32>} : () -> !torch.vtensor<[4096,1024],f32> 
    %none = torch.constant.none
    %2 = torch.operator "onnx.MatMul"(%arg0, %1) : (!torch.vtensor<[64,4096],f32>, !torch.vtensor<[4096,1024],f32>) -> !torch.vtensor<[64,1024],f32> 
    %3 = torch.operator "onnx.Add"(%2, %0) : (!torch.vtensor<[64,1024],f32>, !torch.vtensor<[1024],f32>) -> !torch.vtensor<[64,1024],f32> 
    return %3 : !torch.vtensor<[64,1024],f32>
  }
}

{-#
  dialect_resources: {
    builtin: {
      matmul_bias_stream_b: ""
    }
  }
#-}


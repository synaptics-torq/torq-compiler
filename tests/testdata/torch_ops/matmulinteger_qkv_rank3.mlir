// TORQ_FP_ABS_TOL_FRAC: 0.015
// Both fixtures inherit the same DQL quantization noise as a single
// MatMulInteger chain, but three weight-column sets now draw on it instead
// of one, so the worst branch measures somewhat higher.
module {
  func.func @matmulinteger_qkv_rank3(%arg0: !torch.vtensor<[1,4,16],f32>) -> (!torch.vtensor<[1,4,32],f32>, !torch.vtensor<[1,4,32],f32>, !torch.vtensor<[1,4,32],f32>) attributes {torch.onnx_meta.ir_version = 10 : si64, torch.onnx_meta.opset_version = 21 : si64, torch.onnx_meta.producer_name = "", torch.onnx_meta.producer_version = ""} {
    %0 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<w_zp> : tensor<si8>} : () -> !torch.vtensor<[],si8> 
    %1 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<W_q> : tensor<16x32xsi8>} : () -> !torch.vtensor<[16,32],si8> 
    %2 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<b_scale_q> : tensor<f32>} : () -> !torch.vtensor<[],f32> 
    %3 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<W_k> : tensor<16x32xsi8>} : () -> !torch.vtensor<[16,32],si8> 
    %4 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<b_scale_k> : tensor<f32>} : () -> !torch.vtensor<[],f32> 
    %5 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<W_v> : tensor<16x32xsi8>} : () -> !torch.vtensor<[16,32],si8> 
    %6 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<b_scale_v> : tensor<f32>} : () -> !torch.vtensor<[],f32> 
    %none = torch.constant.none
    %7:3 = torch.operator "onnx.DynamicQuantizeLinear"(%arg0) : (!torch.vtensor<[1,4,16],f32>) -> (!torch.vtensor<[1,4,16],ui8>, !torch.vtensor<[],f32>, !torch.vtensor<[],ui8>) 
    %8 = torch.operator "onnx.MatMulInteger"(%7#0, %1, %7#2, %0) : (!torch.vtensor<[1,4,16],ui8>, !torch.vtensor<[16,32],si8>, !torch.vtensor<[],ui8>, !torch.vtensor<[],si8>) -> !torch.vtensor<[1,4,32],si32> 
    %9 = torch.operator "onnx.Cast"(%8) {torch.onnx.to = 1 : si64} : (!torch.vtensor<[1,4,32],si32>) -> !torch.vtensor<[1,4,32],f32> 
    %10 = torch.operator "onnx.Mul"(%7#1, %2) : (!torch.vtensor<[],f32>, !torch.vtensor<[],f32>) -> !torch.vtensor<[],f32> 
    %11 = torch.operator "onnx.Mul"(%9, %10) : (!torch.vtensor<[1,4,32],f32>, !torch.vtensor<[],f32>) -> !torch.vtensor<[1,4,32],f32> 
    %12 = torch.operator "onnx.MatMulInteger"(%7#0, %3, %7#2, %0) : (!torch.vtensor<[1,4,16],ui8>, !torch.vtensor<[16,32],si8>, !torch.vtensor<[],ui8>, !torch.vtensor<[],si8>) -> !torch.vtensor<[1,4,32],si32> 
    %13 = torch.operator "onnx.Cast"(%12) {torch.onnx.to = 1 : si64} : (!torch.vtensor<[1,4,32],si32>) -> !torch.vtensor<[1,4,32],f32> 
    %14 = torch.operator "onnx.Mul"(%7#1, %4) : (!torch.vtensor<[],f32>, !torch.vtensor<[],f32>) -> !torch.vtensor<[],f32> 
    %15 = torch.operator "onnx.Mul"(%13, %14) : (!torch.vtensor<[1,4,32],f32>, !torch.vtensor<[],f32>) -> !torch.vtensor<[1,4,32],f32> 
    %16 = torch.operator "onnx.MatMulInteger"(%7#0, %5, %7#2, %0) : (!torch.vtensor<[1,4,16],ui8>, !torch.vtensor<[16,32],si8>, !torch.vtensor<[],ui8>, !torch.vtensor<[],si8>) -> !torch.vtensor<[1,4,32],si32> 
    %17 = torch.operator "onnx.Cast"(%16) {torch.onnx.to = 1 : si64} : (!torch.vtensor<[1,4,32],si32>) -> !torch.vtensor<[1,4,32],f32> 
    %18 = torch.operator "onnx.Mul"(%7#1, %6) : (!torch.vtensor<[],f32>, !torch.vtensor<[],f32>) -> !torch.vtensor<[],f32> 
    %19 = torch.operator "onnx.Mul"(%17, %18) : (!torch.vtensor<[1,4,32],f32>, !torch.vtensor<[],f32>) -> !torch.vtensor<[1,4,32],f32> 

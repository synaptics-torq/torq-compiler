// TORQ_FP_MAX_TOL: 0.05
// TORQ_ALLOWED_WRONG: 0.03
// Regression: ONNX nearest-neighbor Resize (FPN upsample) must run on NSS, not CSS.
//
// The PP-OCRv6-tiny detector neck upsamples four feature maps to a common
// [1,16,80,80] (nearest / asymmetric / floor, scale factors 8/4/2), concatenates
// them and applies a 3x3 conv. The ONNX importer turns each nearest Resize into a
// gather: for every output pixel, compute floor(y/scale), floor(x/scale) and fetch
// that input pixel. Those addresses are only known at run time, so the op cannot be
// tiled; it becomes one whole CSS host kernel whose code does not fit:
//   "lld: error: section '.text' will not fit in region 'ITCM': overflowed by N bytes".
//
// The fix rewrites the gather as broadcast + collapse before dispatch formation --
// upscaling by a whole number is just repeating each pixel into an s x s block, and
// a broadcast is tileable and runs on NSS. Before: torq-compile errors. After:
// compiles and matches the reference.
module {
  func.func @"Extracted from {PaddlePaddle Graph in PIR mode}"(%arg0: !torch.vtensor<[1,16,10,10],bf16>, %arg1: !torch.vtensor<[1,16,20,20],bf16>, %arg2: !torch.vtensor<[1,16,40,40],bf16>, %arg3: !torch.vtensor<[1,16,80,80],bf16>) -> !torch.vtensor<[1,16,80,80],bf16> attributes {torch.onnx_meta.ir_version = 10 : si64, torch.onnx_meta.opset_version = 22 : si64, torch.onnx_meta.producer_name = "onnx.utils.extract_model", torch.onnx_meta.producer_version = ""} {
    %0 = torch.operator "onnx.Constant"() {torch.onnx.value = dense<> : tensor<0xf32>} : () -> !torch.vtensor<[0],f32> 
    %1 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<_helper.constant.39> : tensor<4xf32>} : () -> !torch.vtensor<[4],f32> 
    %2 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<_helper.constant.45> : tensor<4xf32>} : () -> !torch.vtensor<[4],f32> 
    %3 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<_helper.constant.47> : tensor<4xf32>} : () -> !torch.vtensor<[4],f32> 
    %4 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<_conv2d_166.w_0_bf16> : tensor<16x64x3x3xbf16>} : () -> !torch.vtensor<[16,64,3,3],bf16> 
    %5 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<_v_902_bf16> : tensor<16xbf16>} : () -> !torch.vtensor<[16],bf16> 
    %none = torch.constant.none
    %6 = torch.operator "onnx.Resize"(%arg0, %0, %2) {torch.onnx.coordinate_transformation_mode = "asymmetric", torch.onnx.mode = "nearest", torch.onnx.nearest_mode = "floor"} : (!torch.vtensor<[1,16,10,10],bf16>, !torch.vtensor<[0],f32>, !torch.vtensor<[4],f32>) -> !torch.vtensor<[1,16,80,80],bf16> 
    %7 = torch.operator "onnx.Resize"(%arg1, %0, %3) {torch.onnx.coordinate_transformation_mode = "asymmetric", torch.onnx.mode = "nearest", torch.onnx.nearest_mode = "floor"} : (!torch.vtensor<[1,16,20,20],bf16>, !torch.vtensor<[0],f32>, !torch.vtensor<[4],f32>) -> !torch.vtensor<[1,16,80,80],bf16> 
    %8 = torch.operator "onnx.Resize"(%arg2, %0, %1) {torch.onnx.coordinate_transformation_mode = "asymmetric", torch.onnx.mode = "nearest", torch.onnx.nearest_mode = "floor"} : (!torch.vtensor<[1,16,40,40],bf16>, !torch.vtensor<[0],f32>, !torch.vtensor<[4],f32>) -> !torch.vtensor<[1,16,80,80],bf16> 
    %9 = torch.operator "onnx.Concat"(%6, %7, %8, %arg3) {torch.onnx.axis = 1 : si64} : (!torch.vtensor<[1,16,80,80],bf16>, !torch.vtensor<[1,16,80,80],bf16>, !torch.vtensor<[1,16,80,80],bf16>, !torch.vtensor<[1,16,80,80],bf16>) -> !torch.vtensor<[1,64,80,80],bf16> 
    %10 = torch.operator "onnx.Conv"(%9, %4, %5) {torch.onnx.dilations = [1 : si64, 1 : si64], torch.onnx.group = 1 : si64, torch.onnx.kernel_shape = [3 : si64, 3 : si64], torch.onnx.pads = [1 : si64, 1 : si64, 1 : si64, 1 : si64], torch.onnx.strides = [1 : si64, 1 : si64]} : (!torch.vtensor<[1,64,80,80],bf16>, !torch.vtensor<[16,64,3,3],bf16>, !torch.vtensor<[16],bf16>) -> !torch.vtensor<[1,16,80,80],bf16> 
    return %10 : !torch.vtensor<[1,16,80,80],bf16>
  }
}

{-#
  dialect_resources: {
    builtin: {
      _helper.constant.39: "0x080000000000803F0000803F0000004000000040",
      _helper.constant.45: "0x080000000000803F0000803F0000004100000041",
      _helper.constant.47: "0x080000000000803F0000803F0000804000008040",
      _conv2d_166.w_0_bf16: "",
      _v_902_bf16: "0x08000000A13EE23D983EF93E853E163F133CADBE5C3DD43E913D773FD03EF63CAB3DD4BD"

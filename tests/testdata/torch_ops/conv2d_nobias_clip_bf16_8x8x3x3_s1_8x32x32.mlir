// onnx.Conv WITHOUT bias + onnx.Clip(0, 6), bf16: the activation was dropped when the conv had no
// bias to fold (negative outputs). input 1x8x32x32, weight 8x8x3x3, stride 1, pads 1.
module {
  func.func @main(%arg0: !torch.vtensor<[1,8,32,32],bf16>) -> !torch.vtensor<[1,8,32,32],bf16> attributes {torch.onnx_meta.ir_version = 10 : si64, torch.onnx_meta.opset_version = 22 : si64} {
    %w = torch.operator "onnx.Constant"() {torch.onnx.value = dense<""> : tensor<8x8x3x3xbf16>} : () -> !torch.vtensor<[8,8,3,3],bf16>
    %conv = torch.operator "onnx.Conv"(%arg0, %w) {torch.onnx.auto_pad = "NOTSET", torch.onnx.dilations = [1 : si64, 1 : si64], torch.onnx.group = 1 : si64, torch.onnx.kernel_shape = [3 : si64, 3 : si64], torch.onnx.pads = [1 : si64, 1 : si64, 1 : si64, 1 : si64], torch.onnx.strides = [1 : si64, 1 : si64]} : (!torch.vtensor<[1,8,32,32],bf16>, !torch.vtensor<[8,8,3,3],bf16>) -> !torch.vtensor<[1,8,32,32],bf16>
    %min = torch.operator "onnx.Constant"() {torch.onnx.value = dense<0.000000e+00> : tensor<bf16>} : () -> !torch.vtensor<[],bf16>
    %max = torch.operator "onnx.Constant"() {torch.onnx.value = dense<6.000000e+00> : tensor<bf16>} : () -> !torch.vtensor<[],bf16>
    %out = torch.operator "onnx.Clip"(%conv, %min, %max) : (!torch.vtensor<[1,8,32,32],bf16>, !torch.vtensor<[],bf16>, !torch.vtensor<[],bf16>) -> !torch.vtensor<[1,8,32,32],bf16>
    return %out : !torch.vtensor<[1,8,32,32],bf16>
  }
}

// onnx.Conv1d WITHOUT bias + onnx.Clip(0, 6), bf16, stride 3: lowers through Conv1D-as-matmul (fully_connected);
// the activation was dropped when the conv had no bias to fold. input 1x16x64, weight 16x16x3, pads 1.
module {
  func.func @main(%arg0: !torch.vtensor<[1,16,64],bf16>) -> !torch.vtensor<[1,16,22],bf16> attributes {torch.onnx_meta.ir_version = 10 : si64, torch.onnx_meta.opset_version = 22 : si64} {
    %w = torch.operator "onnx.Constant"() {torch.onnx.value = dense<""> : tensor<16x16x3xbf16>} : () -> !torch.vtensor<[16,16,3],bf16>
    %conv = torch.operator "onnx.Conv"(%arg0, %w) {torch.onnx.dilations = [1 : si64], torch.onnx.group = 1 : si64, torch.onnx.kernel_shape = [3 : si64], torch.onnx.pads = [1 : si64, 1 : si64], torch.onnx.strides = [3 : si64]} : (!torch.vtensor<[1,16,64],bf16>, !torch.vtensor<[16,16,3],bf16>) -> !torch.vtensor<[1,16,22],bf16>
    %min = torch.operator "onnx.Constant"() {torch.onnx.value = dense<0.000000e+00> : tensor<bf16>} : () -> !torch.vtensor<[],bf16>
    %max = torch.operator "onnx.Constant"() {torch.onnx.value = dense<6.000000e+00> : tensor<bf16>} : () -> !torch.vtensor<[],bf16>
    %out = torch.operator "onnx.Clip"(%conv, %min, %max) : (!torch.vtensor<[1,16,22],bf16>, !torch.vtensor<[],bf16>, !torch.vtensor<[],bf16>) -> !torch.vtensor<[1,16,22],bf16>
    return %out : !torch.vtensor<[1,16,22],bf16>
  }
}

// Wide N: tile-and-fuse leaves a remainder tile, so the reshapes between dequant and matmul become dynamic.
// TORQ_FP_MAX_TOL: 0.1
// TORQ_ALLOWED_WRONG: 0.1
module {
  func.func @main(%arg0: !torch.vtensor<[512,1024],si8>, %arg1: !torch.vtensor<[1,1,512],bf16>) -> !torch.vtensor<[1,1,1024],bf16> attributes {torch.onnx_meta.ir_version = 10 : si64, torch.onnx_meta.opset_version = 21 : si64, torch.onnx_meta.producer_name = "", torch.onnx_meta.producer_version = ""} {
    %0 = torch.operator "onnx.Constant"() {torch.onnx.value = dense<1.0> : tensor<2x1024xbf16>} : () -> !torch.vtensor<[2,1024],bf16> 
    %1 = torch.operator "onnx.Constant"() {torch.onnx.value = dense_resource<dequant_matmul_zp_wide_n_zero_points> : tensor<2x1024xsi8>} : () -> !torch.vtensor<[2,1024],si8> 
    %none = torch.constant.none
    %2 = torch.operator "onnx.DequantizeLinear"(%arg0, %0, %1) {torch.onnx.axis = 0 : si64, torch.onnx.block_size = 256 : si64} : (!torch.vtensor<[512,1024],si8>, !torch.vtensor<[2,1024],bf16>, !torch.vtensor<[2,1024],si8>) -> !torch.vtensor<[512,1024],bf16> 
    %3 = torch.operator "onnx.MatMul"(%arg1, %2) : (!torch.vtensor<[1,1,512],bf16>, !torch.vtensor<[512,1024],bf16>) -> !torch.vtensor<[1,1,1024],bf16> 
    return %3 : !torch.vtensor<[1,1,1024],bf16>
  }
}


    %dqo = torch.operator "onnx.DequantizeLinear"(%qo, %out_scale, %out_zp) : (!torch.vtensor<[1,20,12,12],si8>, !torch.vtensor<[],f32>, !torch.vtensor<[],si8>) -> !torch.vtensor<[1,20,12,12],f32>
    return %dqo : !torch.vtensor<[1,20,12,12],f32>
  }
}

// A bf16 3x3 stride-2 conv from 1x3x224x224 to 32 channels (a MobileNet stem conv).
// On SR200, 16-row tiles of its 112 output rows relocate a buffer; the relocation-free
// search keeps a multiple of 4 rows (12).
module @module {
  func.func @main(%arg0: !torch.vtensor<[1,3,224,224],bf16>) -> !torch.vtensor<[1,32,112,112],bf16> attributes {torch.assume_strict_symbolic_shapes} {
    %0 = torch.vtensor.literal(dense_resource<torch_tensor_32_3_3_3_torch.bfloat16> : tensor<32x3x3x3xbf16>) : !torch.vtensor<[32,3,3,3],bf16>
    %none = torch.constant.none
    %int2 = torch.constant.int 2
    %int2_0 = torch.constant.int 2
    %1 = torch.prim.ListConstruct %int2, %int2_0 : (!torch.int, !torch.int) -> !torch.list<int>
    %int1 = torch.constant.int 1
    %int1_1 = torch.constant.int 1
    %2 = torch.prim.ListConstruct %int1, %int1_1 : (!torch.int, !torch.int) -> !torch.list<int>
    %int1_2 = torch.constant.int 1
    %int1_3 = torch.constant.int 1
    %3 = torch.prim.ListConstruct %int1_2, %int1_3 : (!torch.int, !torch.int) -> !torch.list<int>
    %int1_4 = torch.constant.int 1
    %4 = torch.aten.conv2d %arg0, %0, %none, %1, %2, %3, %int1_4 : !torch.vtensor<[1,3,224,224],bf16>, !torch.vtensor<[32,3,3,3],bf16>, !torch.none, !torch.list<int>, !torch.list<int>, !torch.list<int>, !torch.int -> !torch.vtensor<[1,32,112,112],bf16>
    return %4 : !torch.vtensor<[1,32,112,112],bf16>
  }
}

{-#
  dialect_resources: {
    builtin: {
      torch_tensor_32_3_3_3_torch.bfloat16: ""
    }
  }
#-}

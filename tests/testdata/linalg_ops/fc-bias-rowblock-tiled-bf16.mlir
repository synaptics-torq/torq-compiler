// Regression: bf16 matmul + per-output-channel bias, which Conv2DMatmulPattern fuses
// into one torq_hl.fully_connected. 128x768x768 does not fit in LRAM, so TileAndFuse
// splits the op and the row-blocked (fc-fast) kernel is built once per tile. The cases
// above are whole-tensor ops; this one covers the fast path inside a tiled op.
//
// The weight is an argument, not a constant, purely to keep this file small.
#map = affine_map<(d0) -> (d0)>
#map1 = affine_map<(d0, d1) -> (d0, d1)>
module {
  func.func @main(%arg0: tensor<128x768xbf16>, %arg1: tensor<768x768xbf16>) -> tensor<128x768xbf16> {
    %cst = arith.constant dense<""> : tensor<768xbf16>
    %0 = tensor.empty() : tensor<128x768xf32>
    %1 = tensor.empty() : tensor<768xf32>
    %2 = linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel"]} ins(%cst : tensor<768xbf16>) outs(%1 : tensor<768xf32>) {
    ^bb0(%in: bf16, %out: f32):
      %7 = arith.extf %in : bf16 to f32
      linalg.yield %7 : f32
    } -> tensor<768xf32>
    %broadcasted = linalg.broadcast ins(%2 : tensor<768xf32>) outs(%0 : tensor<128x768xf32>) dimensions = [0]
    %3 = linalg.matmul ins(%arg0, %arg1 : tensor<128x768xbf16>, tensor<768x768xbf16>) outs(%broadcasted : tensor<128x768xf32>) -> tensor<128x768xf32>
    %4 = tensor.empty() : tensor<128x768xbf16>
    %5 = linalg.generic {indexing_maps = [#map1, #map1], iterator_types = ["parallel", "parallel"]} ins(%3 : tensor<128x768xf32>) outs(%4 : tensor<128x768xbf16>) {
    ^bb0(%in: f32, %out: bf16):
      %7 = arith.truncf %in : f32 to bf16
      linalg.yield %7 : bf16
    } -> tensor<128x768xbf16>
    return %5 : tensor<128x768xbf16>
  }
}

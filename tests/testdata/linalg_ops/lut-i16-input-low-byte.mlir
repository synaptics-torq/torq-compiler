// i16 input looked up in a 256-entry i16 LUT through its low byte: trunci i16 -> i8, + 128,
// tensor.extract (variant (a) of I16ExtractTableOpPattern). Inputs span the full i16 range, so
// most of them are outside [-128, 127] and must wrap to their low byte. Distinct LUT values make
// a wrong index visible.
#map = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
func.func @main(%arg0: tensor<1x8x32xi16>) -> tensor<1x8x32xi16> {
  %table = arith.constant dense<[-16384, -10176, -3968, 2240, 8448, 14656, -11904, -5696, 512, 6720, 12928, -13632, -7424, -1216, 4992, 11200, -15360, -9152, -2944, 3264, 9472, 15680, -10880, -4672, 1536, 7744, 13952, -12608, -6400, -192, 6016, 12224, -14336, -8128, -1920, 4288, 10496, -16064, -9856, -3648, 2560, 8768, 14976, -11584, -5376, 832, 7040, 13248, -13312, -7104, -896, 5312, 11520, -15040, -8832, -2624, 3584, 9792, 16000, -10560, -4352, 1856, 8064, 14272, -12288, -6080, 128, 6336, 12544, -14016, -7808, -1600, 4608, 10816, -15744, -9536, -3328, 2880, 9088, 15296, -11264, -5056, 1152, 7360, 13568, -12992, -6784, -576, 5632, 11840, -14720, -8512, -2304, 3904, 10112, 16320, -10240, -4032, 2176, 8384, 14592, -11968, -5760, 448, 6656, 12864, -13696, -7488, -1280, 4928, 11136, -15424, -9216, -3008, 3200, 9408, 15616, -10944, -4736, 1472, 7680, 13888, -12672, -6464, -256, 5952, 12160, -14400, -8192, -1984, 4224, 10432, -16128, -9920, -3712, 2496, 8704, 14912, -11648, -5440, 768, 6976, 13184, -13376, -7168, -960, 5248, 11456, -15104, -8896, -2688, 3520, 9728, 15936, -10624, -4416, 1792, 8000, 14208, -12352, -6144, 64, 6272, 12480, -14080, -7872, -1664, 4544, 10752, -15808, -9600, -3392, 2816, 9024, 15232, -11328, -5120, 1088, 7296, 13504, -13056, -6848, -640, 5568, 11776, -14784, -8576, -2368, 3840, 10048, 16256, -10304, -4096, 2112, 8320, 14528, -12032, -5824, 384, 6592, 12800, -13760, -7552, -1344, 4864, 11072, -15488, -9280, -3072, 3136, 9344, 15552, -11008, -4800, 1408, 7616, 13824, -12736, -6528, -320, 5888, 12096, -14464, -8256, -2048, 4160, 10368, -16192, -9984, -3776, 2432, 8640, 14848, -11712, -5504, 704, 6912, 13120, -13440, -7232, -1024, 5184, 11392, -15168, -8960, -2752, 3456, 9664, 15872, -10688, -4480, 1728, 7936, 14144, -12416, -6208]> : tensor<256xi16>
  %c128 = arith.constant 128 : index
  %init = tensor.empty() : tensor<1x8x32xi16>
  %0 = linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel", "parallel", "parallel"]} ins(%arg0 : tensor<1x8x32xi16>) outs(%init : tensor<1x8x32xi16>) {
  ^bb0(%in: i16, %out: i16):
    %t = arith.trunci %in : i16 to i8
    %i = arith.index_cast %t : i8 to index
    %a = arith.addi %i, %c128 : index
    %v = tensor.extract %table[%a] : tensor<256xi16>
    linalg.yield %v : i16
  } -> tensor<1x8x32xi16>
  return %0 : tensor<1x8x32xi16>
}
